  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>クレスタの森</JapaneseText>
      <EnglishText>Cresta Forest</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>クレスタの森</JapaneseText>
      <EnglishText>Cresta Forest</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>はやく、はやく！</JapaneseText>
      <EnglishText>Hurry, hurry!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>&lt;Kyle&gt;、急いで!!</JapaneseText>
      <EnglishText>&lt;Kyle&gt;, c'mere, quick!!</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>キャアッ！</JapaneseText>
      <EnglishText>Augh!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>だいじょぶかっ!?</JapaneseText>
      <EnglishText>You alright!?</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>早くしろって、&lt;Kyle&gt;！</JapaneseText>
      <EnglishText>Hurry it up already, &lt;Kyle&gt;!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>わかってる！</JapaneseText>
      <EnglishText>I know!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>立てるな？　さ、行くぞ！</JapaneseText>
      <EnglishText>You can get up, right? C'mon, let's go!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>うん！</JapaneseText>
      <EnglishText>Okay!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>うわぁっ!!</JapaneseText>
      <EnglishText>Aaahh!!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>ど、どうしよう････</JapaneseText>
      <EnglishText>N, now what...</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>はさみうちかよっ！</JapaneseText>
      <EnglishText>Oh great, a pincer attack!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>にしても
なんでこんなヤツらが
街の近くに････!?</JapaneseText>
      <EnglishText>And since when have these things been
showing up this close to the town...!?</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>がんばれ、みんな！
力を合わせて
&lt;Kyle&gt;といっしょに戦うんだ！</JapaneseText>
      <EnglishText>Hang in there, everybody!
We're gonna band together
and fight with &lt;Kyle&gt;!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>そ、そんなのできっこないよぉ！</JapaneseText>
      <EnglishText>T, there's just no way we can do that!</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>あっ！　あぶない、&lt;Kyle&gt;!!</JapaneseText>
      <EnglishText>Ah, look out, &lt;Kyle&gt;!!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>こわいよ、&lt;Kyle&gt;････</JapaneseText>
      <EnglishText>I'm scared, &lt;Kyle&gt;...</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>だいじょうぶだ！
オレはどうなっても
おまえたちだけは････必ず守ってみせる！</JapaneseText>
      <EnglishText>It's alright! No matter what happens,
I will...definitely protect you, just watch!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>ぐあっ!!</JapaneseText>
      <EnglishText>Gwah!!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>&lt;Kyle&gt;!!</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>････ぜったいに････
守って････</JapaneseText>
      <EnglishText>...I'll protect you...
no matter what...</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>？？</JapaneseText>
      <EnglishText>??</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>やれやれ････
危ないところだったな、&lt;Kyle&gt;</JapaneseText>
      <EnglishText>Good grief...
that was a close one, wasn't it, &lt;Kyle&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>えっ？</JapaneseText>
      <EnglishText>Eh?</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>？？</JapaneseText>
      <EnglishText>??</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>&lt;Loni&gt;＝デュナミス
ただいま参上････ってな</JapaneseText>
      <EnglishText>Enter the amazing &lt;Loni&gt; Dunamis
...as they say, anyway.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>&lt;Loni&gt;････！</JapaneseText>
      <EnglishText>&lt;Loni&gt;...!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>あっ、&lt;Loni&gt;兄ちゃんだ！</JapaneseText>
      <EnglishText>Ah, it's Big Brother &lt;Loni&gt;!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>おう、おまえら
もうちょっと隠れてろよ</JapaneseText>
      <EnglishText>Yo! You guys go take some
cover for a little bit.</EnglishText>
      <SpeakerId>5</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>&lt;Kyle&gt;、話はあとだ
まずはこいつらを、なんとかするぞ！</JapaneseText>
      <EnglishText>&lt;Kyle&gt;, we'll talk later. Let's do
something about this sucker first!</EnglishText>
      <SpeakerId>5</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>あ、あぁ！</JapaneseText>
      <EnglishText>R, right!</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>&lt;Loni&gt;兄ちゃ～～～ん！</JapaneseText>
      <EnglishText>Lon...I!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>帰ってくるんなら
言ってくれればいいのに！</JapaneseText>
      <EnglishText>You should have told us
that you were coming back!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>おまえらを驚かそうと思ってな
ナイショにしてたんだよ</JapaneseText>
      <EnglishText>I thought I'd surprise you guys,
so I kept it a secret.</EnglishText>
      <SpeakerId>5</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>だが、逆に俺が
驚かされるハメになるとはな
まったく、ヒヤヒヤさせやがって！</JapaneseText>
      <EnglishText>But I didn't think that I'd be the one
who would wind up getting surprised.
Honestly, you scared the crap out of me!</EnglishText>
      <SpeakerId>5</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>&lt;Loni&gt;････
よかっ････た････</JapaneseText>
      <EnglishText>&lt;Loni&gt;...
thank good...ness...</EnglishText>
      <SpeakerId>4</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>&lt;size:00000180&gt;お、おい、だいじょうぶか!?
&lt;Kyle&gt;！　&lt;Kyle&gt;!!</JapaneseText>
      <EnglishText>&lt;size:00000180&gt;H, hey, you alright!?
&lt;Kyle&gt;!　&lt;Kyle&gt;!!</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>45</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>46</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>47</Id>
      <JapaneseText>{16}{25}{BA}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{BA}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>48</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>49</Id>
      <JapaneseText>{16}{25}{C2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText>Found {16}{25}{C2}{C0}, but
inventory full already.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
