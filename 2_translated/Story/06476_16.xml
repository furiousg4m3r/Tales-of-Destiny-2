      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>まぁ、しようがないな</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
