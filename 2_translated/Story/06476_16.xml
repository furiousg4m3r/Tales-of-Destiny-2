    <Entry>
      <Id>43</Id>
      <JapaneseText>材料を持っているじゃないか</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>ゆずってくれれば{16}{34}{7C}{C0}を
作るがどうだい？</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
