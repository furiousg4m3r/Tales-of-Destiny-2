      <Id>49</Id>
      <JapaneseText>吟遊詩人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>立ち上がる～人々～♪
････う～ん、「人々」よりも
「者たち」のほうがいいかな？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>51</Id>
      <JapaneseText>ん？　なにしてんの、あんた？</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>52</Id>
