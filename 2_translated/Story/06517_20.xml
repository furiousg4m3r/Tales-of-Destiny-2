  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>飛行竜・中心部</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>飛行竜</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>noitce</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>制御装置を破壊しないと通れません</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>くそっ！　遅かったか！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>こんなもの！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>いや、おそらくムダだろう
飛行竜は、限りなく生き物に近い機械だ
これを壊してもすぐに再生する</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>じゃあ、どうすればいいの!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>飛行竜の体内にある
制御装置を破壊するんだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>全て壊せば、このロックも
解除されるだろう</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>&lt;Kyle&gt;、さっきフィリアからもらった
ソーサラースコープはあるな？
それを使って、制御装置を見つけるんだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>使うときは、&lt;button:0000003B&gt;ボタンだ
だが、ソーサラーリング以上に
レンズを消費する、気をつけろよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>わかった！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>それと、おそらくだが････
この飛行竜は、カルビオラに向かっている</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>聖地か････
そこで、神さまの降臨を
やりなおそうってワケだね</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>うかうかしていると
やつの目的地に到着してしまう
時間はあまりないぞ</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>わかった！
急いで探そう！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>&lt;Judas&gt;は
称号「&lt;item:00000827&gt;」を得ました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>宝箱はフェイクでした</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>{16}{25}{BE}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{BE}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>{16}{25}{D2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText>Found {16}{25}{C6}{C0}, but
inventory full already.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
