    <Entry>
      <Id>31</Id>
      <JapaneseText>闘技場{18}{44}{70}{C0}{18}{44}{74}{C0}
惜しくも決勝戦で敗れました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>強い！　圧倒的な強さだ！
凶悪なモンスターを、まるで
赤子の手をひねるように倒してしまったぁ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>おっ、盛り上がってんな！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>どうやら、とんでもなく
強いヤツがいるみたいだね
どんなバケモノだろ？</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>あれ？　今の人････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>まったく、どこいっちまったんだ!?
報酬がいらないってのか!?</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>あっ！　なぁ、あんたたち!?
今、リムルが通らなかったか!?</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>リムル？　誰、それ？</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>彗星のごとく現れた
最強の武芸者、リムルだよ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>45</Id>
      <JapaneseText>その剣はあらゆるモンスターを
一瞬にして葬りさるっていう
恐ろしい女さ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>46</Id>
      <JapaneseText>そうか････ヤツだ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>47</Id>
      <JapaneseText>さっきの子か？
この間、すれちがった････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>48</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>49</Id>
      <JapaneseText>あんたたち、見たのか!?
なぁ、どこにいったかわかるか!?</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>さっき、出ていきましたよ
追いかければ、まだ間に合うかも････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>51</Id>
      <JapaneseText>支配人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>52</Id>
      <JapaneseText>そうか、それじゃあ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>53</Id>
      <JapaneseText>あの人、そんなに
すごいのか････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>54</Id>
      <JapaneseText>だから、いっただろう
ただ者ではないと</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>55</Id>
      <JapaneseText>おそらく、闘技場にいるのも
富や名声が目的じゃない
腕試しだろう</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>56</Id>
      <JapaneseText>だから、報酬も受け取らず
出ていっちまうってわけか
何とも、かっこいいねぇ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>57</Id>
      <JapaneseText>観客</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>58</Id>
      <JapaneseText>ひ、ひぇ～～～っ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>59</Id>
      <JapaneseText>観客</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>60</Id>
      <JapaneseText>そっちにいったぞ！
早く逃げろ!!</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>61</Id>
      <JapaneseText>な、なに!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>62</Id>
      <JapaneseText>げえっ!?
どうして、こんなところに
モンスターがいるんだよ!!</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>63</Id>
      <JapaneseText>闘技場のオリから、逃げたんでしょ？
他に考えられないわ</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>64</Id>
      <JapaneseText>････目が、あったな</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>65</Id>
      <JapaneseText>来るよ、みんな！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>66</Id>
      <JapaneseText>リムルさん！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>67</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>68</Id>
      <JapaneseText>ここは、まかせて！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>69</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>70</Id>
      <JapaneseText>････ハッ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>71</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>72</Id>
      <JapaneseText>････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>73</Id>
      <JapaneseText>ね、ねぇ、なにが起こったの!?
速すぎて
よくわからなかったんだけど････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>74</Id>
      <JapaneseText>たんに、切りつけただけだ
ものすごい速さでな</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>75</Id>
      <JapaneseText>なるほど、加速度をエネルギーに変えて
相手にぶつける攻撃方法か
あれは、確かに効くわね</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>76</Id>
      <JapaneseText>しかも、あのスピードでは
かわすことは不可能
まさに、必殺の剣だ</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>77</Id>
      <JapaneseText>すごい････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>78</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>79</Id>
      <JapaneseText>さぁ、ここまで
順調に勝ちあがってきた挑戦者に
最後のカベが立ちはだかる！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>80</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>81</Id>
      <JapaneseText>そのカベは、あまりにも高く
あまりにも大きい！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>82</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>83</Id>
      <JapaneseText>だが、このカベを乗り越えなくして
勝利もまた、ありえない！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>84</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>85</Id>
      <JapaneseText>立ちはだかるカベは
この闘技場のチャンピオン！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>86</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>87</Id>
      <JapaneseText>ある日、彗星のごとく現れ
またたく間に、すべての敵をしりぞけ
王者の座についた女！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>88</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>89</Id>
      <JapaneseText>人は彼女を最強の武芸者と呼び
また、ある人は無敵と呼ぶ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>90</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>91</Id>
      <JapaneseText>その名は････
さぁ！
みなさん、ごいっしょに！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>92</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>93</Id>
      <JapaneseText>さぁ！
みなさん、ごいっしょに！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>94</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>95</Id>
      <JapaneseText>リームールーッ!!</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>96</Id>
      <JapaneseText>リムルさん!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>97</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>98</Id>
      <JapaneseText>････&lt;Kyle&gt;
待ち望んだわ！　この瞬間を！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>99</Id>
      <JapaneseText>待ち望んだって････
どういうこと!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>100</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>101</Id>
      <JapaneseText>勝ったら、教えてあげる････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>102</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>103</Id>
      <JapaneseText>さぁ来なさい、&lt;Kyle&gt;！
今こそ、雌雄を決しましょう！
わたしとキミの、どちらが最強なのかを!!</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>104</Id>
      <JapaneseText>司会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>105</Id>
      <JapaneseText>闘技場バトル
惜しくもリムルに敗れました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>106</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>107</Id>
      <JapaneseText>負けた････
････見事だったわ
&lt;Kyle&gt;････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>108</Id>
      <JapaneseText>リムル</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>109</Id>
      <JapaneseText>さすがは、英雄スタンの血を
受け継ぐものね････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>110</Id>
