      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>110</Id>
      <JapaneseText>それらをまとめて
一冊の本にしようと思っています
未来の人々に、語り継ぐために</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
