<SceneText>
  <FriendlyName>ハイデルベルグ・教会</FriendlyName>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>神官</JapaneseText>
      <EnglishText>Priest</EnglishText>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>&lt;Judas&gt;</JapaneseText>
      <EnglishText>Judas</EnglishText>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>&lt;Kyle&gt;</JapaneseText>
      <EnglishText>Kyle</EnglishText>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>&lt;Loni&gt;</JapaneseText>
      <EnglishText>Loni</EnglishText>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>ハイデルベルグ・教会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>ハイデルベルグ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>教会</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>この街の住人は
幸せになりたいとは
思わないのでしょうか？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>この街には
アタモニ神団に寄進する人間が
ほとんどいないんですよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>みなさん
幸せになりたいとは
思わないのでしょうかねえ？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>寄進なんかしなくても
じゅうぶん幸せなんだろう</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>どの街でも
アタモニ神団に寄進する人々で
あふれているというのに････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>あの～
あなたたち、もしかして････
いや、でもまさか････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>もしかして････
お二人でレンズの寄進に
いらっしゃったとか････？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>いや
ぜんぜんちがうけど････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>ハァ～、やっぱり････
ここの住人が
寄進にくるわけないか････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>どうしてこの街の住人は
レンズの寄進に
おとずれないんでしょう････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>な！
なんなんですか？
あの爆音は!!</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>ほら、やっぱり････
住人たちがレンズを寄進しないから
街が不幸になったんですよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>ああ！
わたしたちまで、まきこまれたら
どうしよう!!</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>みんなが
寄進していれば
アタモニ神のご加護があったのにぃ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>何かお困りですか？
困った時はいつでも来てください</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>この街には
アタモニ神団に寄進する人間が
ほとんどいないんですよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>ハァ････
このぶんだと、今日も
寄進されるレンズはゼロですな</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>みなさんを幸福にみちびこうと
海を渡ってきたのですが････
どうやら必要とされてないようで････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>われわれの布教活動が
足りないんですかねえ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>もっとアタモニ神団の
すばらしさを
みなに広めなくてはなりませんな････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>住人たちが
ここを訪れてくれるように
なんとかがんばらないとな････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>みなさん
どうぞ、だまされたと思って
レンズを････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>いや････
「だまされた」なんて言葉を使うと
ホントにだましてるようだな････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>エルレインさまの
お力を目にすれば
きっと、わかってもらえるのに････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>この混乱こそ
われわれアタモニ神団の価値を
住人たちに見せるチャンスだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>みなを混乱から救いだせば
きっと、これからは
神団をたよってくれるようになる！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>しかし、どうやって
何の力もないわれわれが
みなを救いだせるのだろう････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>あんたたちが
混乱してどうすんだよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>ああ････
なんとかして
住人たちの役にたたねば････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>ハァ････
平和なのは良いことなんですが
こう平和すぎると退屈で････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>ハァ････
このぶんだと、今日も
寄進されるレンズはゼロですな</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>レギーナ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>もうすぐ聖誕祭ですね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>子供たちのプレゼントを
用意しましょう</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>聖誕祭の夜にはサンタさんがやってきて
ステキなプレゼントをくれるんですよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>子供たちの夢は大切にしたいですね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>この教会にはジニーという
女の子がいます</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>とてもピュアな子なんですよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>ジニーはとても素直な子なんです</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>あの子の望みは
かなえてあげたいですね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>あの子、サンタを本当に信じてるんです</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>45</Id>
      <JapaneseText>ほほえましいですよね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>46</Id>
      <JapaneseText>ジニーは身寄りがなくて、
この教会でくらしています</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>47</Id>
      <JapaneseText>とてもいい子なんですよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>48</Id>
      <JapaneseText>サーガちゃんもいい子なんだけど、
ジニーとは正反対なのよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>49</Id>
      <JapaneseText>サーガちゃんはしっかりした子なの</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>だけど、もう少し夢を持った方が
いいかもしれないわね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>51</Id>
      <JapaneseText>次の飛脚便は････
けっこう先になってしまうわ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>52</Id>
      <JapaneseText>いい返事をもらえたら
いいのですが････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>53</Id>
      <JapaneseText>私にはジニーに掛けてあげる
言葉が見つかりません</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>54</Id>
      <JapaneseText>こんな時、フィリアさまなら
どうするのでしょうか</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>55</Id>
      <JapaneseText>フィリアさまから返事は
いただけましたか？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>56</Id>
      <JapaneseText>ジニーの優しい心を
大切にしたいと思います</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>57</Id>
      <JapaneseText>フィリアさまのおかげで子供たちの
笑顔を失わずにすみました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>58</Id>
      <JapaneseText>感謝の極みです</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>59</Id>
      <JapaneseText>夢や希望････
大人になっても忘れては
いけないのですね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>60</Id>
      <JapaneseText>この子は私の一人娘
みたいなものですね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>61</Id>
      <JapaneseText>この教会にはジニーという
女の子が住んでいます</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>62</Id>
      <JapaneseText>この子はバージニア
親しい人はジニーと呼んでいます</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>63</Id>
      <JapaneseText>ジニーはどこに行ったのかしら？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>64</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>65</Id>
      <JapaneseText>私、本当に信じてたの</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>66</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>67</Id>
      <JapaneseText>本当は、もう分かって
しまっているの････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>68</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>69</Id>
      <JapaneseText>フィリアさまに期待してしまう
自分がいるの････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>70</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>71</Id>
      <JapaneseText>サンタさんが本当にいたら
良かったなぁ････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>72</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>73</Id>
      <JapaneseText>事実を教えられて私も
少しは大人になれたのかな？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>74</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>75</Id>
      <JapaneseText>でも、なんか悲しい気持ちなの</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>76</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>77</Id>
      <JapaneseText>私もフィリアさんに
会ってみたいな</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>78</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>79</Id>
      <JapaneseText>私はサンタさんを信じます</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>80</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>81</Id>
      <JapaneseText>サンタさんを信じられなく
なってしまったことが、
ちょっと恥ずかしい</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>82</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>83</Id>
      <JapaneseText>私、バージニアっていうの
ジニーでいいわよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>84</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>85</Id>
      <JapaneseText>私、悪いこと言っちゃった</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>86</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>87</Id>
      <JapaneseText>いい返事がもらえるといいわね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>88</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>89</Id>
      <JapaneseText>フィリアさまはなんて
言ってたの？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>90</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>91</Id>
      <JapaneseText>そうね、その通りよ
私が間違っていたわ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>92</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>93</Id>
      <JapaneseText>私も昔は信じていたのに････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>94</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>95</Id>
      <JapaneseText>大切なことを忘れて
しまっていたのね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>96</Id>
      <JapaneseText>サーガ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>97</Id>
      <JapaneseText>フィリアさまの言葉で
目が覚めました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>98</Id>
      <JapaneseText>レギーナ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>99</Id>
      <JapaneseText>もうすぐ、聖誕祭ね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>100</Id>
      <JapaneseText>ジニー</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>101</Id>
      <JapaneseText>うん！
今年もサンタさん来るかなぁ？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>102</Id>
      <JapaneseText>レギーナ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>103</Id>
      <JapaneseText>ジニーは何が欲しいの？</JapaneseText>
