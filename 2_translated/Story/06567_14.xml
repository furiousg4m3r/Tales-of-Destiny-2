<SceneText>
  <FriendlyName>地上軍拠点</FriendlyName>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>&lt;Harold&gt;</JapaneseText>
      <EnglishText>Harold</EnglishText>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>地上軍拠点</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>地上軍拠点</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>闇商人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>へへ････兄ちゃんたちよ
いい物あるぜ
ちょっと見ていかねえか？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>ちょっとアンタ！
それ軍の備品じゃないの!?
装備の売買は禁止されてるはずよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>うわ！ヤベエ！
軍の関係者かよ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>闇商人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>悪いな兄ちゃん！
そのネエチャンの居ない時に
また来てくんな！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>へへ････ありがとうよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>へへ････またな</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>闇商人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>おい、リキュールボトルは
いくらだよ？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>闇商人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>へへ････そいつはちょっとばかり
値が張るぜ
酒の類は貴重なんでね</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>ちっ、足下みやがって
どうせ、これも軍の横流し品
なんだろ？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>クソッ、軍人どもめ
いつまで俺たち、民間人に
こんな暮らしをさせるつもりだ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>地上軍が勝とうが天上軍が勝とうが
どっちだって大差ないだろうよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>なんでもいいから、とっとと
戦争を終わらせてくれ････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>いよいよ戦争も佳境らしいな
軍人ども、慌ててやがるぜ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>別に地上軍が勝たなくてもいいんだ
戦争さえ終わってくれれば、それでいい</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>戦争が終わったら、戦犯たちは
どうなるんだろうな</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>売人</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>悪くて処刑か････よくても
カルバレイス辺りに流刑だな</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>{16}{25}{BA}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{BA}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>{16}{25}{C2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText>Acquired {16}{25}{C2}{C0} but
inventory is full already.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
