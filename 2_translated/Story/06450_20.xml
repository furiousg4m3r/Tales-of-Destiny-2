      <Id>31</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>&lt;Kyle&gt;さん！
