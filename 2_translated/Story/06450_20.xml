    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>おねがいします、&lt;Kyle&gt;さん！
がんばってください！</JapaneseText>
      <EnglishText/>
