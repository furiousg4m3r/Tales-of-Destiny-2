  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>黄昏都市レアルタ・資料室</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>黄昏都市レアルタ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>資料室</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>ん、これは？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>どうやら、映写機のようだな
ここにあるということは
資料的価値のあるものだろう</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>映像資料ってわけか
もしかしたら、俺たちの探し物は
これかもしれんな</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>ゴチャゴチャ言ってないで
調べてみるのが手っ取りばやいだろ
それっ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>あっ！
バ、バカ、こいつ････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>････これで、ハッキリしたな
やはり、歴史は変えられたんだ
エルレインの手によって</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>天地戦争の勝者と敗者を入れかえ
己が望む世界････人々が神を称え
あがめる世界をつくりあげたんだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>なぁ、&lt;Judas&gt;
ずっと、思ってたんだけどよ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>この世界ができたってことは
俺たちがいた世界は････</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>残念だが、おまえの思っているとおりだ
ゆがめられた歴史のベクトルの上に
僕たちの世界は存在しない････</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>くそッ、なんてこった････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>ようやくハッキリしたね
この世界のからくりってヤツがさ</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>････けどね、「はい、そうですか」って
すべてを受け入れられるほど
あたしは人間ができていないんだよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>オレだってそうさ！
こんな世界を作ったエルレインを
ぜったいに、ゆるせない！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>でも････この世界の人は
みんな、幸せそう</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>えっ？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>････ねぇ、&lt;Kyle&gt;
この世界は、本当に間違っているのかな？</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>たしかに、この世界は
ゆがんだ方法で作られたかもしれない</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>でも、結果として････人々は
幸せに暮らしているじゃない</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>もし、間違ってないんだとしたら
わたしの役目も終わって
&lt;Kyle&gt;とふたりで････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>&lt;Reala&gt;！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>どうしちゃったんだよ、&lt;Reala&gt;！
&lt;Reala&gt;は、このままで
いいっていうのか!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>それは････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>オレはイヤだ！
だって、ここには
だれもいないじゃないか！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>父さんも、母さんも
フィリアさんもウッドロウさんも････
だれもいない！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>このまま、みんなが消えるなんて
オレは････イヤだ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>消える････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>人が消えるということは
その人間が積み上げてきた歴史も
また、消えるということだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>人の歴史を否定し、存在するこの世界････
少なくとも、僕は許せない！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>&lt;Judas&gt;････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>････わかったわ
ごめんなさい、みんな
ヘンなこと、言っちゃって････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>････わかってくれたら、いいんだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>やろう、みんな！
オレたちの世界を、とりもどすんだ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>あぁ！エルレインに
俺たちの意地ってもんを
見せてやろうぜ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>けどさ、どうやったら
世界を元に戻せるんだい？</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>簡単なことだ
エルレインがねじまげた歴史を
元に戻せばいい</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>そのための力は････
&lt;Reala&gt;････
おまえが持っている</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>時間移動････ね</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>････そっか！
天地戦争の時代に行って
エルレインのしたことを
元に戻せばいいんだ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>さっそく行こう、&lt;Reala&gt;！
オレたちをその時代へ連れてってくれ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>それは、ムリだな</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>45</Id>
      <JapaneseText>どうして!?</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>46</Id>
      <JapaneseText>みんなを過去に連れて行くだけの力が
わたしには、ないの････
レンズがあれば、いいのだけど････</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>47</Id>
      <JapaneseText>あ、そっか････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>48</Id>
      <JapaneseText>地上に住む、人々よ････
扉を開け、外においでなさい
そして、神の恵みをその身に････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>49</Id>
      <JapaneseText>あの声は････エルレイン！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>外に行ってみよう！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>51</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>52</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>53</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>54</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>55</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>56</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>57</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>58</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>59</Id>
      <JapaneseText>{16}{25}{CE}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{CE}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>60</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>61</Id>
      <JapaneseText>{16}{25}{D6}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText>Acquired {16}{25}{D6}{C0} but
inventory is full already.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>62</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
  </Strings>
