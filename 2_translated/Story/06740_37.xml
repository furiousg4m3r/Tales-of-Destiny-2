      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>ありがとう、いつも助かるよ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
