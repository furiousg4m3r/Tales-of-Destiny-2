  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>ダイクロフト</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>ダイクロフト</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>エレベーターはまだ戻って来ていません</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>くそっ！　この前は
妙なガキ共に張り倒されるし
今日は今日で地上軍の攻撃かよ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>ああ、やっぱりミクトランなんかに
ついていったのが間違いなんだ････
なぁ、トンズラしちまおうぜ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>逃げ場所なんかねえよ！
それに、地上軍のやつらに捕まってみろ
何をされるか分かったもんじゃない！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>そこをどけぇ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>こ、この前のガキ共!?</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>逃げ場所はない！
大人しく投降しろ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>ど、どうする!?</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>兵士</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>やられっぱなしで終われるかよ！
こいつをくらえ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>くそっ！
このエレベーター
しばらく戻って来ないぞ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>しかたないね！
戻って来るまで
根性で、たえるんだよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>やれやれ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>{16}{25}{EA}{C0}を手に入れました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>{16}{25}{F2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
