  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>地上軍拠点跡地</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>地上軍拠点跡地</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>飛行艇････
････マジかよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>これが、イクシフォスラーだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>天地戦争時代の遺産で、ここに眠っていたのを
オベロン社が見つけだしたそうだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>天地戦争時代の遺産って････
そんな古いもの、本当に動くのかい？</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>心配はいらない
これを作ったのは
かの&lt;Harold&gt;＝ベルセリオス博士だ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>&lt;Harold&gt;博士といやあ、たしか、
ソーディアンを作った人だったよな？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>ソーディアンも、天地戦争での活躍後、
千年もの眠りについていたが、
先の災厄の時にも、ちゃんと使えた</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>その&lt;Harold&gt;博士が作ったものだ
同じように、今でも動くだろう</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>さすがは希代の天才科学者だね</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>それじゃ、急ごう！
&lt;Reala&gt;を助けないと！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>ところで、だれが操縦するんだ？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>この手の乗り物なら、経験がある</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>飛ぶぞ！
しっかりつかまってろ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>&lt;Judas&gt;は
称号「&lt;item:00000825&gt;」を得ました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>すげぇ････
ホントに帰って来てる</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>あったりまえでしょ!?
だれが作ったと思ってんの？</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>ほい、取れた
小さいけど、これひとつあれば
ペンダントの力を増幅できるはずよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>じゃあ、みんな集まって････</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>&lt;Reala&gt;、どうしたの？</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>････&lt;Kyle&gt;、お願いがあるの</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>これから、たとえなにが起こっても････
エルレインを止めるって、誓って</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>どうしたんだよ、&lt;Reala&gt;
そんなの、あたりまえじゃ････</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>お願い、誓って</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>････わかった</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>誓うよ、&lt;Reala&gt;
なにがあっても、エルレインを
止めてみせる、かならず！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>････････
････････うん</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>それじゃ、行くわ
未来へ････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>帰ってきたのはいいとして
問題はこれからどうするかだが････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>････････････････
････････････････</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>やれやれ････
肝心の&lt;Kyle&gt;がこの調子じゃな</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>ムリもないよ
落ち込まない方がどうかしてるさ
あんな話を聞かされた後なんだから</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>&lt;Kyle&gt;････</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>しかし、だからといって
このまま手をこまねいていても
何も変わりはしない</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>36</Id>
      <JapaneseText>エルレインは「神のたまご」を
衝突させるつもりだ
なにがあろうともな</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>37</Id>
      <JapaneseText>････････&lt;Judas&gt;</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>38</Id>
      <JapaneseText>&lt;Kyle&gt;、おまえがいくら悩んだところで
事実は変えようがない</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>39</Id>
      <JapaneseText>おまえが、決めなくてはいけないんだ
この世界をどうするのかを
&lt;Reala&gt;をどうするのかを</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>おい、おまえ････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>････どうすれば、いい？</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>42</Id>
      <JapaneseText>&lt;Kyle&gt;････</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>43</Id>
      <JapaneseText>言ったはずだ
どうするかは、
おまえが決めることだと</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>44</Id>
      <JapaneseText>これは、他の誰にも決められない
&lt;Reala&gt;の英雄となった
おまえしかできないことだ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>45</Id>
      <JapaneseText>英雄････そうか、英雄だ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>46</Id>
      <JapaneseText>この世界にはたくさんの英雄がいる
フィリアさん、ウッドロウさん、
それに母さんも</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>47</Id>
      <JapaneseText>あの人たちなら知ってるかもしれない
こんなとき、どうしたらいいのか
どうするべきなのかを････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>48</Id>
      <JapaneseText>なるほど、英雄の先輩たちに
アドバイスをもらうってわけか
悪くないぜ、そのアイデア</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>49</Id>
      <JapaneseText>いいね、行こう！
ここでじっとしてたって、
なんにもならないしさ</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>50</Id>
      <JapaneseText>なら、足はコイツを使えばいいわ</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>51</Id>
      <JapaneseText>確かに、あちこちいくんなら、
コイツの方が便利だな</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>52</Id>
      <JapaneseText>そーゆーこと！
さ、乗って乗って！</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>53</Id>
      <JapaneseText>行こう、&lt;Kyle&gt;！</JapaneseText>
      <EnglishText/>
      <SpeakerId>6</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>54</Id>
      <JapaneseText>････そうだね、行こう</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>55</Id>
      <JapaneseText>これはなんだろう････？</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>56</Id>
      <JapaneseText>なぜだか分からないけど
乗ったことがあるような気がする････</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>57</Id>
      <JapaneseText>おもしろそうだな
乗ってみようぜ</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>58</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>59</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>60</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>61</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>62</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>63</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>64</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>65</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>66</Id>
      <JapaneseText>{16}{26}{66}{C0}を手に入れました</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>67</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>68</Id>
      <JapaneseText>{16}{26}{6E}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>69</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
