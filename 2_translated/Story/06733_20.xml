  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>飛行竜</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>飛行竜</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>････来たか
崇高な理念を理解できぬ
あわれなる者たちよ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>はいはい、勝手にあわれんでてよ
けど････レンズは、使わせないよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>すなおに、そこをどけ
邪魔だてするならば････斬る！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>&lt;Reala&gt;さま････
本当に、よろしいのか？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>神の救いを拒絶する者たちと
行動すること
とても聖女のすることとは思えません</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>････わたしの求めていた英雄は
&lt;Kyle&gt;だった</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>だから、たとえどんな結果になろうと
彼と共に歩むわ
そう････決めたの</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>&lt;Reala&gt;････</JapaneseText>
      <EnglishText/>
      <SpeakerId>4</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>････あなたは
エルレインさまとは違いすぎる
そんなことでは、救いはもたらせはしない</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>ベラベラしゃべるのは、勝手だがな
そろそろどかねえと、痛い目みるぜ</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>あくまで、飛行竜を止めるつもりか
ならば････！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>ガープ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>おまえたちの相手は
このグラシャラボラスで十分だ</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>おいおい、そんなのアリかよ！</JapaneseText>
      <EnglishText/>
      <SpeakerId>5</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>なんだい、腰が引けてるよ！
痛い目みせるんじゃなかったのかい？</JapaneseText>
      <EnglishText/>
      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>ムダ口はそこまでにしろ
来るぞ････！</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Have a good day.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>31</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>32</Id>
      <JapaneseText>{16}{25}{CA}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{CA}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>33</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>34</Id>
      <JapaneseText>{16}{25}{D2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>35</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
