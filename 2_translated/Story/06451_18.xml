      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>あんた、本当にあの英雄スタンの
息子だったんだな！
こいつは、どデカい事件だ！</JapaneseText>
      <EnglishText/>
