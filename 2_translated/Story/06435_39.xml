    <Entry>
      <Id>200</Id>
      <JapaneseText>巡察官</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>201</Id>
      <JapaneseText>ここは巡察隊の詰め所です</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>202</Id>
      <JapaneseText>巡察官</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>203</Id>
      <JapaneseText>街の平和は我々が守ります！
安心して観光をお続け下さい</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>204</Id>
      <JapaneseText>今は街から出ない方がいい</JapaneseText>
      <EnglishText/>
      <SpeakerId>15</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>205</Id>
      <JapaneseText>ねえ、公園に行きましょうよ</JapaneseText>
      <EnglishText/>
      <SpeakerId>2</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>206</Id>
      <JapaneseText>そうだった</JapaneseText>
      <EnglishText/>
      <SpeakerId>3</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
