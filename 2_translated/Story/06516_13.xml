    <Entry>
      <Id>9</Id>
      <JapaneseText>回復しますか？（&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルド）</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
