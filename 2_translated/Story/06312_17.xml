<SceneText>
  <FriendlyName>Cresta City - Item &amp; Equipment Store</FriendlyName>
  <Speakers>
    <Section>Speaker</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>雑貨屋</JapaneseText>
      <EnglishText>Item Clerk</EnglishText>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>装備屋</JapaneseText>
      <EnglishText>Equipment Clerk</EnglishText>
      <Status>To Do</Status>
    </Entry>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>クレスタの街・雑貨屋＆装備屋</JapaneseText>
      <EnglishText>Cresta City - Item &amp; Equipment Store</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>クレスタの街</JapaneseText>
      <EnglishText>Cresta City</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>雑貨屋＆装備屋</JapaneseText>
      <EnglishText>Item &amp; Equipment Store</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>あら、いらっしゃい！
何か必要なの？</JapaneseText>
      <EnglishText>Oh, welcome!
Do you need anything?</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>またヨロシクね！</JapaneseText>
      <EnglishText>See you soon!</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>何も買ってくれないの？</JapaneseText>
      <EnglishText>You're not buying anything?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>雑貨屋</JapaneseText>
      <EnglishText>Item Clerk</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>8</Id>
      <JapaneseText>あら、いらっしゃい！</JapaneseText>
      <EnglishText>Oh, welcome!</EnglishText>
      <SpeakerId>1</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>9</Id>
      <JapaneseText>よお！何か買っていってくれよ！</JapaneseText>
      <EnglishText>Yo! Please buy something!</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>10</Id>
      <JapaneseText>ありがとな！</JapaneseText>
      <EnglishText>Thank you!</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>11</Id>
      <JapaneseText>何も買ってくれないなんて
せちがらいぜ！</JapaneseText>
      <EnglishText>I can't believe you didn't buy anything.
What a cheapass!</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>12</Id>
      <JapaneseText>装備屋</JapaneseText>
      <EnglishText>Equipment Clerk</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>よお！いつも元気だな！</JapaneseText>
      <EnglishText>Hey! Good seeing you!</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>14</Id>
      <JapaneseText>コラ！
勝手に売り物に触っちゃ
ダメでしょ！</JapaneseText>
      <EnglishText>Hey!
You can't touch the merchandise
without permission!</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>この水車で
小麦粉をひいているようだ</JapaneseText>
      <EnglishText>Looks like they're using this
water mill to grind flour.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>16</Id>
      <JapaneseText>クレスタの台所を支えている
大事な水車だ
触らないでおこう</JapaneseText>
      <EnglishText>The waterwheel is the backbone of
Cresta's kitchen, so let's not touch it.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>17</Id>
      <JapaneseText>『アクアヴェイル産ミソ・一袋で２９８ガルド』
と書かれている</JapaneseText>
      <EnglishText>It says:
&quot;Aquiveil Miso: 298 Gald each&quot;</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>18</Id>
      <JapaneseText>ミソ・スープはアクアヴェイル地方の
代表的な家庭料理らしい</JapaneseText>
      <EnglishText>Miso soup is a typical home-style
dish in the Aquaveil region.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>19</Id>
      <JapaneseText>いってらっしゃいませ</JapaneseText>
      <EnglishText>Welcome</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>20</Id>
      <JapaneseText>&lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt;ガルドになりますが
お泊まりになりますか？</JapaneseText>
      <EnglishText>It'll be &lt;0B:00000001&gt;{14}{34}{08}{C0}&lt;0B:00000000&gt; gald a night.
Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>21</Id>
      <JapaneseText>お泊まりになりますか？</JapaneseText>
      <EnglishText>Would you like to stay?</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>22</Id>
      <JapaneseText>&lt;03:00000000&gt;　はい　
　いいえ　</JapaneseText>
      <EnglishText>&lt;03:00000000&gt; Yes 
 No </EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>23</Id>
      <JapaneseText>ごゆっくりお休みください</JapaneseText>
      <EnglishText>Have a good night.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>おはようございます</JapaneseText>
      <EnglishText>Good morning.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>お金が足りません</JapaneseText>
      <EnglishText>Not enough money.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>またのおこしをお待ちしております</JapaneseText>
      <EnglishText>See you again soon.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>27</Id>
      <JapaneseText>{16}{25}{CA}{C0}を手に入れました</JapaneseText>
      <EnglishText>Acquired {16}{25}{CA}{C0}.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>28</Id>
      <JapaneseText>&lt;item:FFFFFFFF&gt;を手に入れました</JapaneseText>
      <EnglishText>Acquired &lt;item:FFFFFFFF&gt;.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>29</Id>
      <JapaneseText>{16}{25}{D2}{C0}がありましたが
いっぱいで持てませんでした</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>30</Id>
      <JapaneseText>何もありません</JapaneseText>
      <EnglishText>There's nothing here.</EnglishText>
      <Status>Editing</Status>
    </Entry>
  </Strings>
