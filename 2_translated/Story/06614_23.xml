    <Entry>
      <Id>53</Id>
      <JapaneseText>自由を愛する男</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>54</Id>
      <JapaneseText>感じるかい？　熱いＢＥＡＴ！
