    <Entry>
      <Id>57</Id>
      <JapaneseText>自由を愛する男</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>58</Id>
      <JapaneseText>俺がこのＢＡＹに
