    <Entry>
      <Id>74</Id>
      <JapaneseText>自由を愛する男</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>75</Id>
      <JapaneseText>魂がＳＹＮＣＨＲＯＮＩＺＥできたなら････
