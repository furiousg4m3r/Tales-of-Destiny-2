Let's do it, &lt;Loni&gt;!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>40</Id>
      <JapaneseText>せぇーの････</JapaneseText>
      <EnglishText>Ready, set...</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>41</Id>
      <JapaneseText>&lt;size:00000200&gt;わっ！</JapaneseText>
      <EnglishText>&lt;size:00000200&gt;BOO!</EnglishText>
      <SpeakerId>3</SpeakerId>
      <Status>Editing</Status>
