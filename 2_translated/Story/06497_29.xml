    <Entry>
      <Id>12</Id>
      <JapaneseText>くるしいよ････
&lt;Nanaly&gt;姉ちゃん････</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>13</Id>
      <JapaneseText>ルー</JapaneseText>
