      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>24</Id>
      <JapaneseText>お金が足りないね</JapaneseText>
      <EnglishText>You don't have enough Gald.</EnglishText>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>25</Id>
      <JapaneseText>{16}{35}{D8}{C0}のレシピを
売ってあげよう</JapaneseText>
      <EnglishText>I can sell 
you the recipe for {16}{35}{D8}{C0}.</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
    <Entry>
      <Id>26</Id>
      <JapaneseText>まぁ、しようがないな</JapaneseText>
      <EnglishText>Well, it can't be helped.</EnglishText>
      <SpeakerId>2</SpeakerId>
      <Status>Editing</Status>
    </Entry>
