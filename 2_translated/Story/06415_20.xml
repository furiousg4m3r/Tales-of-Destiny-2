      <SpeakerId>1</SpeakerId>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>15</Id>
      <JapaneseText>おかあさんが
お屋敷で働いてたころは
ちゃんとお金、出なかったんですって～</JapaneseText>
