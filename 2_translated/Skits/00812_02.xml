<SceneText>
  <Speakers>
    <Section>Speaker</Section>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>なあ、&lt;Judas&gt;。もしスタンさんたちに会ったら、どうするんだ？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>そうだよ。言えなかったこと‥‥たくさんあるんだろ？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>弁解するつもりはない。それに、過去は否定しないと、あの時決めたはずだ。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>でもよぉ‥‥。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>‥‥&lt;Judas&gt;がそう決めたんなら、オレはそれでいいと思うよ。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>&lt;Kyle&gt;‥‥。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
