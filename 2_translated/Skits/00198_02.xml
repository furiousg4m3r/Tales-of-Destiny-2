<SceneText>
  <Speakers>
    <Section>Speaker</Section>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>ファンダリアへは、海路を使って行くことになる。おまえたち、準備はできているか？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>あ、ヤベ！　オレ、まだ買ってないよ！　アレがないと、あっちではタイヘンだもんな！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>え？　買うって、なにを？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>へへっ、ポカポカカイロだよ！　あったかいんだぜ！　雪国の必需品さ！</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>‥‥あのな、&lt;Kyle&gt;。&lt;Judas&gt;が言ったのは、海の路のほうの「カイロ」だ。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
