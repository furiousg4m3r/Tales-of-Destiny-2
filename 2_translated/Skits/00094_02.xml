<SceneText>
  <Speakers>
    <Section>Speaker</Section>
  </Speakers>
  <Strings>
    <Section>Main</Section>
    <Entry>
      <Id>1</Id>
      <JapaneseText>&lt;Judas&gt;のヤツ、なんで仮面なんかつけてたんだろうな？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>2</Id>
      <JapaneseText>きっと「おたずね者」なんだよ。しかも、すっごく有名な！　だから、ああやって顔を隠してたんだ。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>3</Id>
      <JapaneseText>バカ！　あんな仮面してたら、よけいに目立つだろうが。俺のするどい分析によると、あれは‥‥。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>4</Id>
      <JapaneseText>うんうん。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>5</Id>
      <JapaneseText>あれはそうとうな‥‥。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>6</Id>
      <JapaneseText>そうとうな‥‥？</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
    <Entry>
      <Id>7</Id>
      <JapaneseText>ブ男だ。</JapaneseText>
      <EnglishText/>
      <Status>To Do</Status>
    </Entry>
  </Strings>
  <Strings>
    <Section>system</Section>
  </Strings>
</SceneText>
